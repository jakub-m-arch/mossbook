{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Mossbook",
	"version": "0.5.0",
	"identifier": "io.github.jakubmarch.mossbook",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"title": "Mossbook",
				"width": 1000,
				"height": 720,
				"minWidth": 360,
				"minHeight": 480,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; media-src blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
			"devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:5173; media-src blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
			"freezePrototype": true
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"license": "GPL-3.0-or-later",
		"category": "Lifestyle",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		},
		"macOS": {
			"signingIdentity": "-",
			"entitlements": "Entitlements.plist"
		}
	}
}
